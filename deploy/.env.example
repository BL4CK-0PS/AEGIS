# AERIS local stack — copy to deploy/.env and replace every CHANGE_ME.
# deploy/.env is git-ignored. Never commit real values.
# Generate passwords with:  openssl rand -base64 24

COMPOSE_PROJECT_NAME=aeris

# PostgreSQL 18
POSTGRES_USER=aeris
POSTGRES_DB=aeris
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=127.0.0.1:5432

# NATS 2.15 + JetStream
NATS_SERVER_NAME=aeris-nats-1
NATS_SIMD_USER=aeris-simd
NATS_SIMD_PASSWORD=CHANGE_ME
NATS_SERVER_USER=aeris-server
NATS_SERVER_PASSWORD=CHANGE_ME
NATS_PORT=127.0.0.1:4222
NATS_MONITOR_PORT=127.0.0.1:8222

# aeris-simd (compose profile "sim")
# Key directory produced by:  cargo run -p aeris-simd -- keygen --out deploy/keys
AERIS_KEY_DIR=./keys
# UID/GID that owns the 0600 key files (the container runs as this user).
AERIS_UID=1000
AERIS_GID=1000
AERIS_SCENARIO=s4
AERIS_SEED=7
AERIS_SPEED=1.0
